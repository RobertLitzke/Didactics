{
  // What runs in Node is also shipped compiled into lib/, since Node will not
  // run TypeScript from node_modules: the build helper (src/vite.ts), which an
  // app's vite.config.ts loads, and the course tools (src/course.ts and
  // src/blocks.ts), which bin/didactics-course.mjs uses. `npm run build`
  // writes them; a test fails if they are out of date.
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": false,
    "declaration": true,
    "allowImportingTsExtensions": true,
    "rewriteRelativeImportExtensions": true,
    "types": ["node"],
    "outDir": "lib",
    "rootDir": "src"
  },
  "include": ["src/vite.ts", "src/course.ts", "src/blocks.ts"]
}
